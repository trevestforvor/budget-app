# The Budget server's settings on a Mac. install.sh writes the real file to
# ~/Library/Application Support/BudgetServer/budget.env (mode 600) with fresh secrets; edit that one, not this.
# Every variable is described in docs/SERVER.md → Configuration. Most can also be set later on the dashboard.

# What the phone sends as "Authorization: Bearer …". install.sh generates it (openssl rand -hex 32).
BUDGET_API_TOKEN=
# Seals bank access tokens at rest. install.sh generates it (openssl rand -base64 32).
# Lose it and every bank has to be linked again: keep a copy in a password manager.
BUDGET_TOKEN_KEY=

# Loopback only. The phone reaches port 8080 through an HTTPS tunnel; the dashboard (8081) has no login and must never
# be reachable from another machine (use an SSH tunnel: ssh -L 8081:127.0.0.1:8081 <this mac>).
HOST=127.0.0.1
PORT=8080
DASHBOARD_PORT=8081

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=budget
POSTGRES_DB=budget
# POSTGRES_PASSWORD=

# Where months begin and end. install.sh fills in this Mac's zone.
BUDGET_TIMEZONE=America/New_York

# The API's public HTTPS address (shown on the dashboard under "Connect your phone").
# BUDGET_PUBLIC_URL=https://budget.example.com
# Server 0.6.0: Plaid's webhooks and the phone's reconnect hang off that address too (it must be the API's, never the
# dashboard's). The phone's reconnect also needs the app's id for the Universal Link, and
# <BUDGET_PUBLIC_URL>/plaid/oauth-return in Plaid's allowed redirect URIs (docs/SERVER.md, "Olares and Plaid").
# BUDGET_IOS_APP_ID=ABCDE12345.com.yourname.budget

# Optional, also settable on the dashboard: models, Plaid, APNs. See docs/INSTALL-SERVER.md.
# A model set here is listed under Settings → Models as "From install settings" and is used until you pick another there.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=<the model id your endpoint serves>
# OPENROUTER_API_KEY=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# BUDGET_PLAID_HOLDINGS=auto        # auto | on | off (investment holdings, once a day per bank login)
# BUDGET_SIMPLEFIN_DAILY_PULLS=4    # 1-20; the server never passes 20 SimpleFIN requests a day
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.yourname.budget
