# The Budget server's settings in Docker. ./setup.sh server docker writes the real file, budget.env beside this one
# (mode 600, never committed), with fresh secrets; edit that one, then: docker compose -f deploy/docker/compose.yaml up -d
# compose.yaml sets HOST, the ports and POSTGRES_HOST itself. Every variable: docs/SERVER.md → Configuration.

# What the phone sends as "Authorization: Bearer …" (openssl rand -hex 32).
BUDGET_API_TOKEN=
# Seals bank access tokens at rest (openssl rand -base64 32).
# Lose it and every bank has to be linked again: keep a copy in a password manager, with the backups.
BUDGET_TOKEN_KEY=

# The Postgres container's login, used by the server and the backup too. setup.sh generates the password.
POSTGRES_USER=budget
POSTGRES_DB=budget
POSTGRES_PASSWORD=

# Where months begin and end. setup.sh fills in this machine's zone.
BUDGET_TIMEZONE=America/New_York

# The API's public HTTPS address (shown on the dashboard under "Connect your phone"). ./setup.sh address sets it.
# BUDGET_PUBLIC_URL=https://budget.example.com

# Optional, also settable on the dashboard: models, Plaid, APNs. See docs/INSTALL-SERVER.md.
# A model set here is listed under Settings → Models as "From install settings" and is used until you pick another there.
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=<the model id your endpoint serves>
# OPENROUTER_API_KEY=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.yourname.budget
